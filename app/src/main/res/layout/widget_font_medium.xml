<?xml version="1.0" encoding="utf-8"?>
<!-- Generated from widget.xml by tools/gen_font_layouts.py - do not edit by hand. -->
<!-- Main widget layout. All sizes are overridden at runtime by WidgetRenderer. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/bg_fill_r0" />

    <ImageView
        android:id="@+id/bg_outline"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/bg_outline_w2_r0" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- mainCluster: time | current icon | current temp (fixed, not scrollable) -->
        <LinearLayout
            android:id="@+id/main_cluster"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal">

            <TextClock
                android:id="@+id/time"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif-medium"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/main_dark"
                android:textSize="28sp" />

            <LinearLayout
                android:id="@+id/current_box"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/current_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:scaleType="fitCenter" />

                <!-- temperature with a small C/F tucked under the degree sign -->
                <FrameLayout
                    android:id="@+id/temp_box"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/current_temp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/secondary_dark"
                        android:textSize="28sp" />

                    <TextView
                        android:id="@+id/current_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/secondary_dark"
                        android:textSize="10sp" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 2dp separator, floating away from the top and bottom edges -->
        <FrameLayout
            android:id="@+id/separator"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="#FF000000" />

        <!-- Forecast stripe. App widgets have no horizontal scrolling container, so this is
             a vertical ListView rotated -90deg (items are rotated back +90deg). -->
        <FrameLayout
            android:id="@+id/forecast_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ListView
                android:id="@+id/forecast_list"
                android:layout_width="60dp"
                android:layout_height="200dp"
                android:layout_gravity="left|center_vertical"
                android:cacheColorHint="#00000000"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:fadingEdge="none"
                android:listSelector="#00000000"
                android:overScrollMode="never"
                android:rotation="-90"
                android:scrollbars="none" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
